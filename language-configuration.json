{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["comment"] },
    { "open": "[", "close": "]", "notIn": ["comment"] },
    { "open": "(", "close": ")", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"]],
  "wordPattern": "[A-Za-z_][A-Za-z_0-9]*(?:[.-][A-Za-z_0-9]+)*|[+-]?(?:0x[0-9a-fA-F]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)",
  "indentationRules": {
    "increaseIndentPattern": "^[^#]*(?:\\{[^}#]*|\\[[^\\]#]*|\\([^\\)#]*)(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
